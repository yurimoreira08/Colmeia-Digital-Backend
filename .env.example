# Copie para .env e preencha. Nunca faça commit do .env com valores reais.

# Servidor
PORT=4000
# development | production (em produção, e-mails sem provedor não são impressos no log)
NODE_ENV=development

# Banco (PostgreSQL / Supabase). ATENÇÃO: hoje existe um único banco, que é o de produção.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Supabase Storage (fotos)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET_NAME=colmeia-digital

# Origens web liberadas no CORS, separadas por vírgula. O app nativo não precisa disto.
# Ex.: CORS_ORIGINS=http://localhost:8081
CORS_ORIGINS=

# Proxies confiáveis para descobrir o IP real do cliente (rate limit). O padrão confia só
# na rede privada, o que funciona no Render. Confira com GET /api/v1/health/client-ip.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# E-mail de recuperação de senha: Resend (preferido) ou SMTP
RESEND_API_KEY=
RESEND_FROM=Colmeia Digital <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
