{
  "name": "colmeia-digital-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "seed": "tsx prisma/seed.ts",
    "check-db": "tsx scripts/check-counts.ts",
    "dry-run-cleanup": "tsx scripts/cleanup-duplicate-boxes.ts",
    "cleanup-db": "tsx scripts/cleanup-duplicate-boxes.ts --execute",
    "test-stats": "tsx scripts/test-stats.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "bcryptjs": "^2.4.3",
    "@prisma/client": "^5.22.0",
    "pg": "^8.11.3",
    "@supabase/supabase-js": "^2.39.8",
    "nodemailer": "^6.9.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
