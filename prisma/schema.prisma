// Schema do banco (PostgreSQL / Supabase). Mudanças aqui viram migrations em
// prisma/migrations: rode `npm run db:migrate:create` contra um banco local,
// revise o SQL gerado e aplique em produção com `npm run db:migrate:deploy`
// (sempre depois de scripts/backup-db.ps1). Nunca use `prisma db push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int       @id @default(autoincrement())
  name                   String
  email                  String    @unique
  password_hash          String
  photo                  String?
  terms_accepted_at      DateTime?
  terms_version          String?
  terms_accepted_version String?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  sessions        Session[]
  apiaries        Apiary[]
  password_resets PasswordReset[]
  notifications   Notification[]
  deleted_records DeletedRecord[]

  @@map("users")
}

model PasswordReset {
  id         Int       @id @default(autoincrement())
  user_id    Int
  code_hash  String
  expires_at DateTime
  used_at    DateTime?
  /// Tentativas erradas de código desde a criação; ao chegar no limite o código é invalidado.
  attempts   Int       @default(0)
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([code_hash])
  @@map("password_resets")
}

model Session {
  id          Int      @id @default(autoincrement())
  user_id     Int
  token_hash  String   @unique
  device_info String?
  expires_at  DateTime
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
  @@map("sessions")
}

/// O dono do apiário é dono de tudo que está nele (caixas, revisões, manejos).
model Apiary {
  id          Int      @id @default(autoincrement())
  /// Gerado no aparelho: torna idempotente a criação pelo POST /sync.
  client_uuid String?  @unique
  user_id     Int
  name        String
  location    String
  box_count   Int      @default(0)
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  boxes          Box[]
  review_reports ReviewReport[]
  manejos        Manejo[]

  @@index([user_id])
  @@index([user_id, updated_at])
  @@map("apiaries")
}

model Box {
  id          Int      @id @default(autoincrement())
  /// Gerado no aparelho: torna idempotente a criação pelo POST /sync.
  client_uuid String?  @unique
  apiary_id   Int
  user_id     Int?
  name        String
  position    Int
  archived    Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  apiary         Apiary         @relation(fields: [apiary_id], references: [id], onDelete: Cascade)
  review_reports ReviewReport[]
  manejos        Manejo[]

  @@index([apiary_id, archived])
  @@index([user_id])
  @@index([updated_at])
  @@map("boxes")
}

model ReviewReport {
  id              Int      @id @default(autoincrement())
  client_uuid     String?  @unique
  user_id         Int?
  apiary_id       Int?
  apiary_name     String?
  caixa_id        Int
  caixa_name      String
  tipo            String
  checked_options String
  observacoes     String?
  indicacoes      String?
  archived        Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  box     Box      @relation(fields: [caixa_id], references: [id], onDelete: Cascade)
  apiary  Apiary?  @relation(fields: [apiary_id], references: [id], onDelete: Cascade)
  manejos Manejo[]

  @@index([apiary_id, caixa_id])
  @@index([user_id])
  @@index([created_at])
  @@index([updated_at])
  @@map("review_reports")
}

model Manejo {
  id              Int      @id @default(autoincrement())
  client_uuid     String?  @unique
  user_id         Int?
  apiary_id       Int?
  apiary_name     String?
  caixa_id        Int
  caixa_name      String
  tipo            String
  revisao_id      Int?
  checked_options String
  observacoes     String?
  indicacoes      String?
  photo_uri       String?
  archived        Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  box     Box           @relation(fields: [caixa_id], references: [id], onDelete: Cascade)
  apiary  Apiary?       @relation(fields: [apiary_id], references: [id], onDelete: Cascade)
  /// Se a revisão de origem for excluída, o manejo fica e só perde o vínculo.
  revisao ReviewReport? @relation(fields: [revisao_id], references: [id], onDelete: SetNull)

  @@index([apiary_id, caixa_id])
  @@index([user_id])
  @@index([created_at])
  @@index([revisao_id])
  @@index([updated_at])
  @@map("manejos")
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  title      String
  subtitle   String
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("notifications")
}

model AppConfig {
  key   String @id
  value String

  @@map("app_config")
}

/// Exclusões feitas no servidor, para o pull incremental do sync (GET /sync/changes).
/// Sem isto o aparelho não saberia que um registro sumiu. Apagar um apiário
/// ou caixa gera um registro só para ele: o app apaga os filhos localmente.
model DeletedRecord {
  id         Int      @id @default(autoincrement())
  user_id    Int
  /// Tabela do registro: apiaries, boxes, review_reports ou manejos.
  entity     String
  record_id  Int
  deleted_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, deleted_at])
  @@map("deleted_records")
}
